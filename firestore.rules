rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pulseTokens/{tokenId} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function platformAdmin() {
      return signedIn() && (
        request.auth.token.platform_admin == true ||
        request.auth.token.role == 'super_admin'
      );
    }

    function propertyDoc(propertyId) {
      return get(/databases/$(database)/documents/properties/$(propertyId)).data;
    }

    function propertyExists(propertyId) {
      return exists(/databases/$(database)/documents/properties/$(propertyId));
    }

    function tokenRole(propertyId) {
      return request.auth.token.keys().hasAny(['properties'])
        ? request.auth.token.properties[propertyId]
        : null;
    }

    function docMemberRole(propertyId) {
      return propertyDoc(propertyId).keys().hasAny(['members'])
        ? propertyDoc(propertyId).members[request.auth.uid]
        : null;
    }

    function manages(propertyId) {
      return platformAdmin() || (
        signedIn() &&
        propertyExists(propertyId) &&
        (
          propertyDoc(propertyId).ownerId == request.auth.uid ||
          docMemberRole(propertyId) in ['host_admin', 'staff'] ||
          tokenRole(propertyId) in ['host_admin', 'staff']
        )
      );
    }

    function hosts(propertyId) {
      return platformAdmin() || (
        signedIn() &&
        propertyExists(propertyId) &&
        (
          propertyDoc(propertyId).ownerId == request.auth.uid ||
          docMemberRole(propertyId) == 'host_admin' ||
          tokenRole(propertyId) == 'host_admin'
        )
      );
    }

    // ACL fields must only change via privileged Cloud Functions (setPropertyMember, etc.).
    function propertyAclUnlocked() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['ownerId', 'members', 'id']);
    }

    // Phone → uid index for mobile + password sign-in. Functions only.
    match /phone_logins/{e164} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || platformAdmin());
      allow create, delete: if false;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.propertyIds == resource.data.propertyIds;

      match /travel/{documentId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /vouchers/{voucherId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }

      match /dealClaims/{dealId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }

      match /savedEvents/{eventId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /savedStalls/{stallId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /calendar/{eventId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /likes/{likeId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /device/{docId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /follows/{handle} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /zoo/{docId} {
        allow read, write: if signedIn() && request.auth.uid == userId && !isAnonymous();
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /hostAlerts/{alertId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if false;
      }
    }

    // App invites: one inviter per joiner (doc id = invitee uid).
    // Both sides can read; only the invitee can create their own row.
    match /referrals/{inviteeUid} {
      allow get: if signedIn()
        && (request.auth.uid == inviteeUid || resource.data.inviterUid == request.auth.uid);
      allow list: if signedIn()
        && (request.auth.uid == inviteeUid || resource.data.inviterUid == request.auth.uid);
      allow create: if signedIn()
        && request.auth.uid == inviteeUid
        && request.resource.data.inviteeUid == inviteeUid
        && request.resource.data.inviterUid is string
        && request.resource.data.inviterUid != inviteeUid;
      allow update, delete: if false;
    }

    // Star ledger: server-written on first completed experiences (see
    // completePlanRemote). Clients read only their own rows, never write.
    match /star_ledger/{entryId} {
      allow get, list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /events/{eventId} {
      allow get, list: if resource.data.status in ['live', 'ended']
        || (signedIn() && resource.data.organiserUid == request.auth.uid)
        || platformAdmin();
      allow create: if signedIn()
        && !isAnonymous()
        && request.resource.data.organiserUid == request.auth.uid
        && request.resource.data.keys().hasAny(['updatedAt']);
      allow update, delete: if signedIn() && resource.data.organiserUid == request.auth.uid
        || platformAdmin();

      match /stalls/{stallId} {
        allow get, list: if true;
        allow write: if signedIn() && (
          get(/databases/$(database)/documents/events/$(eventId)).data.organiserUid == request.auth.uid
          || platformAdmin()
        );
      }

      match /feedback/{ratingId} {
        allow read: if signedIn() && (
          resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/events/$(eventId)).data.organiserUid == request.auth.uid
          || platformAdmin()
        );
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emoji is string
          && request.resource.data.mood is string;
        allow update, delete: if false;
      }
    }

    // Festival week programs: sessions stay on `events` (festivalSlug).
    // Public to read once live; the organiser publishes, admins can intervene.
    match /festivals/{slug} {
      allow get, list: if resource.data.status in ['live', 'ended']
        || (signedIn() && resource.data.createdByUid == request.auth.uid)
        || platformAdmin();
      allow create: if signedIn()
        && !isAnonymous()
        && request.resource.data.slug == slug
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.city is string
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.status in ['draft', 'live'];
      allow update: if signedIn()
        && (resource.data.createdByUid == request.auth.uid || platformAdmin())
        && request.resource.data.slug == slug
        && request.resource.data.createdByUid == resource.data.createdByUid;
      allow delete: if signedIn() && platformAdmin();
    }

    match /properties/{propertyId} {
      // Public property docs must not contain wifi.password — see private/hostSecrets.
      allow read: if true;
      allow create: if platformAdmin()
        && request.resource.data.ownerId is string
        && request.resource.data.id == propertyId;
      allow update: if hosts(propertyId) && propertyAclUnlocked();
      allow delete: if hosts(propertyId);

      match /feedback/{ratingId} {
        allow read: if hosts(propertyId) || platformAdmin()
          || (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emoji is string
          && request.resource.data.mood is string;
        allow update, delete: if false;
      }

      match /deals/{documentId} {
        allow read: if true;
        allow create, update, delete: if manages(propertyId);
      }
      match /menu/{documentId} {
        allow read: if true;
        allow create, update, delete: if manages(propertyId);
      }
      match /places/{documentId} {
        allow read: if true;
        allow create, update, delete: if manages(propertyId);
      }
      match /qrCodes/{documentId} {
        allow read: if true;
        allow create, update, delete: if manages(propertyId);
      }
      match /dealSecrets/{documentId} {
        allow read, write: if hosts(propertyId);
      }

      // Host-only secrets (wifi.password and similar). Guests use getPropertyWifi callable.
      match /private/{docId} {
        allow read, write: if hosts(propertyId);
      }

      match /tickets/{ticketId} {
        allow read: if manages(propertyId);
        allow create: if signedIn()
          && propertyExists(propertyId)
          && request.resource.data.propertyId == propertyId
          && request.resource.data.status == 'pending'
          && request.resource.data.category in ['reception', 'housekeeping', 'maintenance', 'dining', 'late_checkout']
          && request.resource.data.urgency in ['normal', 'urgent']
          && request.resource.data.roomNumber is string
          && request.resource.data.guestName is string
          && request.resource.data.details is string
          && request.resource.data.details.size() < 2000;
        allow update, delete: if manages(propertyId)
          && request.resource.data.propertyId == resource.data.propertyId
          && request.resource.data.id == resource.data.id;
      }

      
      match /pulses/{pulseId} {
        allow read: if manages(propertyId);
        allow create, update, delete: if false;
      }
      match /pulseDeployments/{deploymentId} {
        allow read: if manages(propertyId);
        allow create, update, delete: if false;
      }
      match /pulseResponses/{responseId} {
        allow read: if manages(propertyId);
        allow create, update, delete: if false;
      }
      match /pulseIssues/{issueId} {
        allow read: if manages(propertyId);
        allow create, update, delete: if false;
      }

match /dining_orders/{orderId} {
        allow read: if manages(propertyId)
          || (signedIn() && resource.data.guestUid == request.auth.uid);
        allow create, update, delete: if false;
      }

      match /events/{eventId} {
        allow read: if manages(propertyId);
        allow create: if signedIn()
          && propertyExists(propertyId)
          && request.resource.data.propertyId == propertyId
          && request.resource.data.name is string
          && request.resource.data.name.size() < 160;
        allow update, delete: if manages(propertyId);
      }

      match /conversations/{conversationId} {
        allow read: if manages(propertyId);
        allow create: if signedIn()
          && propertyExists(propertyId)
          && request.resource.data.propertyId == propertyId
          && request.resource.data.question is string
          && request.resource.data.question.size() < 4000;
        allow update, delete: if manages(propertyId);
      }

      match /transactions/{transactionId} {
        allow read: if manages(propertyId);
        // Commercial writes require a non-anonymous signed-in user.
        allow create: if signedIn()
          && !isAnonymous()
          && propertyExists(propertyId)
          && request.resource.data.propertyId == propertyId
          && request.resource.data.kind in ['upsell', 'experience', 'dining']
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0;
        allow update, delete: if manages(propertyId);
      }

      match /staffPresence/{staffId} {
        allow read: if manages(propertyId);
        allow create, update: if manages(propertyId)
          && propertyExists(propertyId)
          && request.resource.data.propertyId == propertyId
          && request.resource.data.status in ['available', 'busy', 'on_break', 'off_shift'];
        allow delete: if manages(propertyId);
      }
    }

    // D3 host-blocked nights: public to read (quoting needs them), host-managed writes.
    match /stay_blocks/{blockId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.propertyId is string
        && request.resource.data.date is string
        && request.resource.data.keys().hasOnly(['propertyId', 'date', 'reason', 'createdAt', 'updatedAt'])
        && manages(request.resource.data.propertyId);
      allow update, delete: if signedIn() && manages(resource.data.propertyId);
    }

    match /businessDeals/{dealId} {
      allow read: if true;
      allow write: if false;
    }

    match /businessDealSecrets/{dealId} {
      allow read, write: if false;
    }

    match /vouchers/{voucherId} {
      allow read: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        platformAdmin()
      );
      allow write: if false;
    }

    match /partnerVenues/{venueId} {
      allow read: if true;
      allow write: if false;
    }

    match /handles/{handle} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /profiles/{profileId} {
      allow get: if true;
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;

      match /taps/{day} {
        allow get: if signedIn() && get(/databases/$(database)/documents/profiles/$(profileId)).data.ownerUid == request.auth.uid;
        allow list: if signedIn() && get(/databases/$(database)/documents/profiles/$(profileId)).data.ownerUid == request.auth.uid;
        allow write: if false;
      }

      match /claims/{claimId} {
        allow get: if signedIn() && (
          resource.data.uid == request.auth.uid ||
          get(/databases/$(database)/documents/profiles/$(profileId)).data.ownerUid == request.auth.uid
        );
        allow list: if signedIn() && get(/databases/$(database)/documents/profiles/$(profileId)).data.ownerUid == request.auth.uid;
        allow write: if false;
      }
    }

    match /listings/{listingId} {
      allow get, list: if resource.data.status == 'active'
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || platformAdmin();
      allow create: if signedIn()
        && !isAnonymous()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAny(['updatedAt']);
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid
        || platformAdmin();
    }

    // Partnership inquiries: anyone can introduce themselves (tightly validated);
    // only admins read and triage. No sign-in so discovery converts.
    match /partner_leads/{leadId} {
      allow get, list: if signedIn() && platformAdmin();
      allow create: if request.resource.data.segment in ['stay', 'experience', 'event', 'fashion', 'other']
        && request.resource.data.source in ['google', 'ai', 'word', 'other']
        && request.resource.data.company is string
        && request.resource.data.company.size() > 0 && request.resource.data.company.size() < 121
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 81
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10 && request.resource.data.message.size() < 2001
        && request.resource.data.status == 'new';
      allow update: if signedIn() && platformAdmin();
      allow delete: if false;
    }

    // AirPal Studio walkthrough bookings: owner + admins can read; team triages.
    match /studio_walkthroughs/{bookingId} {
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        platformAdmin()
      );
      allow create: if signedIn()
        && !isAnonymous()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAny(['updatedAt']);
      allow update: if signedIn() && platformAdmin();
      allow delete: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        platformAdmin()
      );
    }

    // §20 operating system: every admin action writes here. Admins only.
    match /admin_audits/{auditId} {
      allow create: if signedIn() && platformAdmin()
        && request.resource.data.actorUid == request.auth.uid;
      allow read: if signedIn() && platformAdmin();
      allow update, delete: if false;
    }

    // B2B engine: campaigns are public once live; bookings tracked per campaign.
    // Money movement is deferred until Stripe lands (paymentStatus == 'deferred').
    match /campaigns/{campaignId} {
      // C4 — campaigns are the Partner tool: same login needs an active
      // subscription row (written by Stripe webhooks, never the client).
      function partnerActive() {
        return exists(/databases/$(database)/documents/business_subscriptions/$(request.auth.uid))
          && get(/databases/$(database)/documents/business_subscriptions/$(request.auth.uid)).data.status in ['active', 'trialing'];
      }
      allow get, list: if resource.data.status == 'live'
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || platformAdmin();
      allow create: if signedIn()
        && !isAnonymous()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAny(['updatedAt'])
        && (partnerActive() || platformAdmin());
      allow update: if signedIn() && (
        platformAdmin() ||
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.status == resource.data.status)
      );
      allow delete: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        platformAdmin()
      );
    }

    match /campaign_rsvps/{rsvpId} {
      allow create: if signedIn()
        && !isAnonymous()
        && request.resource.data.attendeeUid == request.auth.uid
        && request.resource.data.keys().hasAny(['updatedAt']);
      allow read: if signedIn() && (
        resource.data.attendeeUid == request.auth.uid ||
        platformAdmin() ||
        get(/databases/$(database)/documents/campaigns/$(resource.data.campaignId)).data.ownerUid == request.auth.uid
      );
      allow update, delete: if signedIn() && (
        resource.data.attendeeUid == request.auth.uid ||
        platformAdmin()
      );
    }

    // Giveaways & Promotions: public once live/closed; all writes via callables.
    match /promotions/{promotionId} {
      allow get, list: if resource.data.status == 'live'
        || resource.data.status == 'closed'
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || platformAdmin();
      allow write: if false;
    }

    match /promotion_entries/{entryId} {
      allow get, list: if signedIn() && (
        resource.data.uid == request.auth.uid
        || platformAdmin()
        || get(/databases/$(database)/documents/promotions/$(resource.data.promotionId)).data.ownerUid == request.auth.uid
      );
      allow write: if false;
    }

    match /promotion_audit_logs/{logId} {
      allow read: if signedIn() && platformAdmin();
      allow write: if false;
    }

    // Draw results: the selected entrant and admins only. Public display
    // uses the masked winnerNote on the promotion doc.
    match /promotion_winners/{winnerId} {
      allow get, list: if signedIn() && (
        resource.data.uid == request.auth.uid || platformAdmin()
      );
      allow write: if false;
    }

    match /promotion_notifications/{noteId} {
      allow get, list: if signedIn() && (
        resource.data.uid == request.auth.uid || platformAdmin()
      );
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    match /promotion_terms/{termsId} {
      allow get, list: if signedIn() && (
        platformAdmin()
        || get(/databases/$(database)/documents/promotions/$(resource.data.promotionId)).data.ownerUid == request.auth.uid
      );
      allow write: if false;
    }

    match /promotion_weeks/{weekId} {
      allow get, list: if true;
      allow write: if false;
    }

    // Birthday month freebies: public read for live; writes only via callables.
    match /birthday_offers/{offerId} {
      allow get, list: if resource.data.status == 'live'
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || platformAdmin();
      allow write: if false;
    }

    match /rewards/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || platformAdmin());
      allow write: if false;
    }

    match /reward_transactions/{txId} {
      allow get, list: if signedIn() && (
        resource.data.uid == request.auth.uid || platformAdmin()
      );
      allow write: if false;
    }

    // Creator broadcasts: owner drafts, admin reviews, functions send.
    match /broadcasts/{broadcastId} {
      allow get, list: if signedIn() && (
        resource.data.ownerUid == request.auth.uid || platformAdmin()
      );
      allow create: if signedIn()
        && !isAnonymous()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'draft';
      allow update: if signedIn() && (
        platformAdmin()
        || (resource.data.ownerUid == request.auth.uid && resource.data.status == 'draft')
      );
      allow delete: if signedIn() && (
        resource.data.ownerUid == request.auth.uid || platformAdmin()
      );
    }

    match /promotion_redemptions/{redemptionId} {
      allow get, list: if signedIn() && (
        resource.data.uid == request.auth.uid || platformAdmin()
        || get(/databases/$(database)/documents/promotions/$(resource.data.promotionId)).data.ownerUid == request.auth.uid
      );
      allow write: if false;
    }

    match /account_deletions/{uid} {
      allow create, get: if signedIn() && !isAnonymous() && request.auth.uid == uid;
      allow list, update, delete: if platformAdmin();
    }

    match /platform_settings/{docId} {
      allow read: if signedIn();
      allow write: if platformAdmin();
    }

    // Public Mate cards — first name + area. Admin writes on approve/suspend.
    match /mates_public/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if platformAdmin();
    }

    // §9 shared booking engine. $0 is paid; otherwise unpaid until Stripe confirms.
    // Money fields (price, fees, payment/payout, Stripe ids) are Functions-only.
    match /bookings/{bookingId} {
      allow create: if signedIn()
        && !isAnonymous()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentStatus in ['deferred', 'unpaid', 'paid']
        && request.resource.data.priceCents is number
        && request.resource.data.priceCents >= 0
        && (request.resource.data.priceCents == 0 || request.resource.data.paymentStatus != 'paid')
        && (!request.resource.data.keys().hasAny(['feeCents'])
          || (request.resource.data.feeCents is number && request.resource.data.feeCents >= 0))
        && request.resource.data.keys().hasAny(['updatedAt']);
      allow read: if signedIn() && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.providerUid == request.auth.uid ||
        platformAdmin()
      );
      allow update: if signedIn() && (
        platformAdmin() ||
        (
          (
            resource.data.customerUid == request.auth.uid
            || resource.data.providerUid == request.auth.uid
          )
          && resource.data.status in ['pending', 'confirmed', 'in_progress']
          && request.resource.data.customerUid == resource.data.customerUid
          && request.resource.data.providerUid == resource.data.providerUid
          && request.resource.data.priceCents == resource.data.priceCents
          && request.resource.data.feeCents == resource.data.feeCents
          && request.resource.data.paymentStatus == resource.data.paymentStatus
          && request.resource.data.status in ['pending', 'confirmed', 'cancelled', 'in_progress']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'cancelReason'])
        )
      );
      allow delete: if false;
    }

    match /connect_accounts/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || platformAdmin());
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if signedIn() && platformAdmin();
      allow write: if false;
    }

    match /managed_products/{productId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /managed_payments/{paymentId} {
      allow read: if signedIn() && (
        platformAdmin() || resource.data.buyerUid == request.auth.uid
      );
      allow write: if false;
    }

    match /payouts/{payoutId} {
      allow read: if signedIn() && (
        platformAdmin() || resource.data.providerUid == request.auth.uid
      );
      allow write: if false;
    }

    // C2 deposit ledger: guest + host read their own rows; money moves via Functions only.
    match /plan_bookings/{bookingId} {
      allow read: if signedIn() && (
        platformAdmin()
        || resource.data.guestUid == request.auth.uid
        || resource.data.hostUid == request.auth.uid
      );
      allow write: if false;
    }

    // C4 Partner subscriptions: owner + admin read; Stripe webhooks own the writes.
    match /business_subscriptions/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || platformAdmin());
      allow write: if false;
    }

    // C5 experience reviews: one per completed paid booking (doc id = booking
    // id, so create fails on a second review). Public to read — trust content.
    match /experience_reviews/{bookingId} {
      function reviewedBooking() {
        return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      }
      allow create: if signedIn()
        && !isAnonymous()
        && request.resource.data.guestUid == request.auth.uid
        && request.resource.data.planId is string
        && request.resource.data.bookingId == bookingId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.reviewText is string
        && request.resource.data.reviewText.size() <= 500
        && request.resource.data.guestName is string
        && request.resource.data.guestName.size() >= 1
        && request.resource.data.guestName.size() <= 40
        && request.resource.data.keys().hasOnly(['guestUid', 'planId', 'bookingId', 'rating', 'reviewText', 'guestName', 'createdAt', 'updatedAt'])
        && reviewedBooking().customerUid == request.auth.uid
        && reviewedBooking().planId == request.resource.data.planId
        && reviewedBooking().status == 'completed'
        && reviewedBooking().paymentStatus == 'paid';
      allow get, list: if true;
      allow update, delete: if signedIn() && platformAdmin();
    }

    // §8 messaging: universal conversations (AirPal Chat) — participants only,
    // admins read-only for moderation. No personal phone/email exposure by default.
    match /conversations/{conversationId} {
      function convParty() {
        return signedIn() && !isAnonymous()
          && request.auth.uid in resource.data.participantUids;
      }
      function convPartyCreate() {
        return signedIn() && !isAnonymous()
          && request.auth.uid in request.resource.data.participantUids;
      }
      allow create: if convPartyCreate()
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() >= 1
        && request.resource.data.participantUids.size() <= 20
        && request.resource.data.keys().hasAny(['updatedAt']);
      allow read: if convParty() || (signedIn() && platformAdmin());
      allow update: if convParty();
      allow delete: if false;

      match /messages/{messageId} {
        function msgParty() {
          return signedIn() && !isAnonymous()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
        }
        allow create: if msgParty()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.keys().hasAny(['createdAt']);
        allow get, list: if msgParty() || (signedIn() && platformAdmin());
        allow update: if msgParty()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
        allow delete: if false;
      }
    }

    // §8 messaging: one chat per matched request, parties only (+ admins for moderation).
    match /request_chats/{requestId} {
      function chatParty() {
        return signedIn() && !isAnonymous() && (
          get(/databases/$(database)/documents/mate_requests/$(requestId)).data.ownerUid == request.auth.uid ||
          get(/databases/$(database)/documents/mate_requests/$(requestId)).data.matchedMateUid == request.auth.uid
        );
      }
      allow create: if chatParty()
        && request.resource.data.requestId == requestId
        && request.resource.data.keys().hasAny(['updatedAt']);
      allow read: if chatParty() || (signedIn() && platformAdmin());
      allow update: if chatParty();
      allow delete: if false;

      match /messages/{messageId} {
        allow create: if chatParty()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.keys().hasAny(['updatedAt']);
        allow get, list: if chatParty() || (signedIn() && platformAdmin());
        allow update: if chatParty()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
        allow delete: if false;
      }
    }

    // Trust moat: safety reports open admin cases; blocks are private to the blocker.
    match /safety_reports/{reportId} {
      allow read: if signedIn() && (
        resource.data.reporterUid == request.auth.uid ||
        platformAdmin()
      );
      allow create: if signedIn()
        && !isAnonymous()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.keys().hasAny(['updatedAt']);
      allow update: if signedIn() && platformAdmin();
      allow delete: if false;
    }

    match /blocks/{blockId} {
      allow create: if signedIn()
        && !isAnonymous()
        && request.resource.data.blockerUid == request.auth.uid;
      allow get: if signedIn() && (resource.data.blockerUid == request.auth.uid || platformAdmin());
      allow list: if signedIn() && platformAdmin();
      allow update, delete: if signedIn() && resource.data.blockerUid == request.auth.uid;
    }

    // AirPal Mate requests: owner + assigned mate; approved Mates can read open ones and accept.
    match /mate_requests/{requestId} {
      function approvedMate() {
        return signedIn() && !isAnonymous() && exists(/databases/$(database)/documents/mates_public/$(request.auth.uid));
      }
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.matchedMateUid == request.auth.uid ||
        platformAdmin() ||
        (resource.data.status == 'open' && approvedMate())
      );
      allow create: if signedIn()
        && !isAnonymous()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasAny(['updatedAt']);
      allow update: if signedIn() && (
        platformAdmin() ||
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && resource.data.status == 'completed'
          && request.resource.data.status == 'completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewText', 'updatedAt'])) ||
        (approvedMate()
          && resource.data.status == 'open'
          && request.resource.data.status == 'matched'
          && request.resource.data.matchedMateUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'matchedMateUid', 'matchedMateName', 'updatedAt'])) ||
        (resource.data.matchedMateUid == request.auth.uid
          && resource.data.status == 'matched'
          && request.resource.data.status == 'completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'completedAt'])) ||
        (resource.data.matchedMateUid == request.auth.uid
          && resource.data.status == 'completed'
          && request.resource.data.status == 'completed'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['mateRating', 'mateReviewText', 'updatedAt']))
      );
      allow delete: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        platformAdmin()
      );
    }

    match /partnerClaims/{claimId} {
      allow read: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        platformAdmin()
      );
      allow write: if false;
    }

    // AirPal Ping: lightweight hangout nudges. Sender owns the ping;
    // only the recipient moves it forward (sent → pinged_back /
    // hanging_out / dismissed); sender may cancel their own sent ping.
    // Mirrors canTransitionPing in shared/ping.ts — keep in sync.
    match /pings/{pingId} {
      function pingParty() {
        return signedIn()
          && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      }
      allow read: if signedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid ||
        platformAdmin()
      );
      allow create: if signedIn()
        && !isAnonymous()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'sent'
        && request.resource.data.keys().hasAny(['updatedAt']);
      allow update: if signedIn() && (
        platformAdmin() ||
        // Sender cancels their own sent ping.
        (resource.data.fromUid == request.auth.uid
          && resource.data.status == 'sent'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        // Recipient answers a sent ping.
        (resource.data.toUid == request.auth.uid
          && resource.data.status == 'sent'
          && request.resource.data.status in ['pinged_back', 'hanging_out', 'dismissed']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'respondedAt'])) ||
        // Either party closes a live thread.
        (pingParty()
          && resource.data.status in ['pinged_back', 'hanging_out']
          && request.resource.data.status in ['hanging_out', 'dismissed']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'respondedAt']))
      );
      allow delete: if false;
    }

    // AirPal Companion applications: applicant owns their doc, admins review.
    // Private adminNotes must never be served to non-admins; clients use the
    // public projection for any shared view.
    match /companion_applications/{applicationId} {
      allow get, list: if signedIn()
        && (resource.data.userId == request.auth.uid || platformAdmin());
      allow create: if platformAdmin() || (signedIn()
        && !isAnonymous()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['draft', 'submitted']
        && request.resource.data.keys().hasOnly([
          'applicationId', 'userId', 'roles', 'fullName', 'photo', 'email', 'phone',
          'city', 'suburb', 'ageRange', 'introduction', 'languages', 'interests',
          'hobbies', 'enjoysWithOthers', 'activities', 'availability', 'serviceArea',
          'pricingPreference', 'preferredRate', 'motivation', 'policeClearanceNumber',
          'policeClearanceDoc', 'applicantAgreementAccepted',
          'communityGuidelinesAccepted', 'adultConfirmed', 'status', 'submittedAt', 'createdAt', 'updatedAt',
        ]));
      allow update: if platformAdmin()
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status in ['draft', 'more_info']
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status in ['draft', 'submitted']);
      allow delete: if platformAdmin();
    }

    // Share-by-id: anyone signed in with the link can get a trip; listing the collection is blocked.
    match /trips/{tripId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.id == tripId
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Physical marker docs for /q/{markerHex}. Public get; list only own property/owner.
    match /markers/{markerId} {
      allow get: if true;
      allow list: if platformAdmin() || (
        resource.data.keys().hasAny(['propertyId']) &&
        resource.data.propertyId is string &&
        hosts(resource.data.propertyId)
      ) || (
        signedIn() &&
        resource.data.keys().hasAny(['ownerUid']) &&
        resource.data.ownerUid == request.auth.uid
      );
      allow create: if platformAdmin() || (
        request.resource.data.propertyId is string && hosts(request.resource.data.propertyId)
      ) || (
        signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.kind == 'venue'
      );
      allow update, delete: if platformAdmin() || (
        resource.data.propertyId is string && hosts(resource.data.propertyId)
      ) || (
        signedIn() && resource.data.ownerUid == request.auth.uid
      );
    }

    // City-only presence for Circle. Exact GPS never stored here.
    match /presence/{handle} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Event-space “I’m here” pins. Rounded venue coords only; writes via callables.
    match /here_pins/{handle} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /here_at/{placeKey} {
      match /pins/{handle} {
        allow read: if signedIn();
        allow write: if false;
      }
    }
    match /here_shares/{shareId} {
      allow get, list: if signedIn() && (
        resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid
      );
      allow write: if false;
    }

    // Venue Wave: greet AirPals in the room. Writes via callables.
    match /waves/{code} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /wave_here/{placeKey} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /wave_hits/{hitId} {
      allow get, list: if signedIn() && (
        resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid
      );
      allow write: if false;
    }
    match /wave_owners/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /graph/{handle} {
      match /followers/{fromHandle} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
      match /likedBy/{fromHandle} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    match /precincts/{precinctId} {
      allow get, list: if resource.data.status == 'active' || platformAdmin();
      allow write: if platformAdmin();
    }

    // Published walking tours (Guide). Public read; admin writes via seed/console.
    match /tours/{tourId} {
      allow get, list: if true;
      allow write: if platformAdmin();
    }

    // Campus companion docs for /c/{id}. Public get; list is admin-only.
    match /campuses/{campusId} {
      allow get: if true;
      allow list: if platformAdmin();
      allow write: if platformAdmin();
    }

    // Zoo hunts. Public read so a scan can resolve a sticker without sign-in.
    match /zooHunts/{huntId} {
      allow get, list: if true;
      allow write: if platformAdmin();
    }

    // Precinct Nearby places. Query must include status == 'active' for public list.
    match /places/{placeId} {
      allow get, list: if resource.data.status == 'active' || platformAdmin() || (
        resource.data.keys().hasAny(['propertyId']) &&
        resource.data.propertyId is string &&
        manages(resource.data.propertyId)
      );
      allow create, update: if platformAdmin() || (
        request.resource.data.propertyId is string && hosts(request.resource.data.propertyId)
      ) || (
        signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.source == 'partner'
      );
      allow delete: if platformAdmin() || (
        resource.data.propertyId is string && hosts(resource.data.propertyId)
      ) || (
        signedIn() && resource.data.ownerUid == request.auth.uid
      );
    }

    match /nearbyEvents/{eventId} {
      allow get, list: if resource.data.status == 'active' || platformAdmin() || (
        resource.data.keys().hasAny(['propertyId']) &&
        resource.data.propertyId is string &&
        manages(resource.data.propertyId)
      );
      allow create, update, delete: if platformAdmin() || (
        request.resource.data.propertyId is string && hosts(request.resource.data.propertyId)
      );
    }

    match /scanEvents/{eventId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.markerId is string
        && request.resource.data.kind in [
          'open', 'category', 'place', 'place_view', 'ask', 'issue', 'offers', 'order',
          'booking_click', 'booking_return'
        ];
      allow get: if platformAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow list, update, delete: if platformAdmin();
    }

    match /analyticsEvents/{eventId} {
      allow read: if platformAdmin();
      allow write: if false;
    }

    match /analyticsEventRejects/{docId} {
      allow read: if platformAdmin();
      allow write: if false;
    }

    match /analyticsDaily/{docId} {
      allow read: if platformAdmin() || (
        signedIn() &&
        resource.data.keys().hasAny(['tenantId']) &&
        resource.data.tenantId == request.auth.uid
      );
      allow write: if false;
    }

    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    match /abuseSignals/{docId} {
      allow read: if platformAdmin();
      allow write: if false;
    }

    match /contentAudits/{docId} {
      allow read: if platformAdmin();
      allow write: if false;
    }

    match /booking_clicks/{clickId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow get: if platformAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow list, update, delete: if platformAdmin();
    }

    // Hangout & Outing Plans collection
    match /plans/{planId} {
      allow get: if resource.data.isPublic == true
        || platformAdmin()
        || (signedIn() && resource.data.creator.uid == request.auth.uid)
        || resource.data.status in ['open', 'confirmed'];
      allow list: if resource.data.isPublic == true
        || platformAdmin()
        || (signedIn() && resource.data.creator.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.id is string
        && request.resource.data.title is string
        && request.resource.data.date is string
        && request.resource.data.time is string;
      allow update: if platformAdmin()
        || (signedIn() && resource.data.creator.uid == request.auth.uid)
        || (signedIn() && (
          // Collaborators/Guests can RSVP, add stops, or add comments
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees', 'stops', 'comments', 'subscribers', 'updatedAt'])
        ));
      allow delete: if platformAdmin()
        || (signedIn() && resource.data.creator.uid == request.auth.uid);

      match /activity/{activityId} {
        allow read: if resource.data.isPublic == true
          || platformAdmin()
          || (signedIn() && get(/databases/$(database)/documents/plans/$(planId)).data.creator.uid == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.keys().hasOnly(['text', 'authorId', 'authorName', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if platformAdmin()
          || (signedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    // 1-on-1 catch-up / meeting / hangout proposals from a public bio.
    match /catchups/{catchupId} {
      allow create: if signedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.targetHandle is string
        && request.resource.data.requesterName is string;
      allow get, list: if signedIn() && (
        resource.data.requesterUid == request.auth.uid
        || resource.data.targetOwnerUid == request.auth.uid
      );
      allow update, delete: if signedIn() && (
        resource.data.requesterUid == request.auth.uid
        || resource.data.targetOwnerUid == request.auth.uid
      );
    }

    // Log search queries for relevance tracking, analytics, and query intent
    match /search_queries/{queryId} {
      allow create: if request.resource.data.query is string
        && request.resource.data.query.size() >= 2
        && request.resource.data.query.size() <= 120;
      allow read: if true;
      allow update, delete: if platformAdmin();
    }

    // Aggregated popular search terms (publicly readable for relevance improvements & suggestions)
    match /popular_searches/{termId} {
      allow read: if true;
      allow create, update: if request.resource.data.term is string
        && request.resource.data.term.size() >= 2
        && request.resource.data.term.size() <= 120;
      allow delete: if platformAdmin();
    }
  }
}
