{
  "name": "airpalme",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "start": "npm run dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "functions:typecheck": "npm --prefix functions run typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "functions:test": "npm --prefix functions run test",
    "functions:build": "npm --prefix functions run build",
    "ci:install": "npm ci && npm --prefix functions ci",
    "rules:check": "node scripts/check-rules.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "seo:check": "node scripts/check-seo.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "audit": "npm audit --audit-level=high && npm --prefix functions audit --audit-level=high",
    "verify": "npm run typecheck && npm run functions:typecheck && npm run lint && npm test && npm run functions:test && npm run build && npm run functions:build && npm run rules:check && npm run secrets:check && npm run seo:check",
    "ci": "npm run ci:install && npm run verify && npm run audit",
    "deploy": "npm run verify && npx -y firebase-tools@latest deploy --project airpalme-app",
    "deploy:hosting": "npm run build && npx -y firebase-tools@latest deploy --only hosting --project airpalme-app",
    "deploy:rules": "npx -y firebase-tools@latest deploy --only firestore:rules,storage --project airpalme-app",
    "deploy:functions": "npm run functions:build && npx -y firebase-tools@latest deploy --only functions --project airpalme-app",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "cap:run:ios": "npx cap run ios",
    "cap:run:android": "npx cap run android"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@vis.gl/react-google-maps": "^1.10.0",
    "firebase": "^12.19.0",
    "framer-motion": "^12.23.22",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.1.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.7.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.6"
  }
}
